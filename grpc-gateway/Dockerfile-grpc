# Build context must be the repository root because grpc-gateway belongs to the root module.
FROM golang:1.25-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY grpc-gateway ./grpc-gateway
RUN CGO_ENABLED=0 go build -o /out/grpc-backend ./grpc-gateway/server

FROM alpine:3.22

COPY --from=build /out/grpc-backend /usr/local/bin/grpc-backend

EXPOSE 8080

CMD ["grpc-backend"]
