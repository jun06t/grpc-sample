# Build context must be the repository root because grpc-gateway belongs to the root module.
FROM golang:1.25-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY grpc-gateway ./grpc-gateway
RUN CGO_ENABLED=0 go build -o /out/grpc-gateway ./grpc-gateway/gateway

FROM alpine:3.22

COPY --from=build /out/grpc-gateway /usr/local/bin/grpc-gateway

EXPOSE 3000

CMD ["grpc-gateway"]
